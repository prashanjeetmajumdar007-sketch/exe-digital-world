# EXE DIGITAL WORLD Environment Variables Example

# Storefront Branding & Base Configuration
VITE_APP_TITLE="EXE DIGITAL WORLD"
VITE_APP_TAGLINE="Your Digital World, All in One Place"
VITE_CURRENCY="INR"

# Admin Authentication Passkey (Default fallback: admin123)
VITE_ADMIN_PASSKEY="admin123"

# Meta Pixel Analytics Tracking ID (Optional - For Live Facebook / Meta Ads Pixel)
VITE_META_PIXEL_ID="123456789012345"

# Database / Remote Storage Credentials (Optional - For Production DB Integration)
VITE_DATABASE_URL="https://your-db-instance.supabase.co"
VITE_DATABASE_KEY="your-anon-or-service-role-key"

# Payment Gateway Configuration (Optional - Connect Razorpay / PhonePe / Stripe)
VITE_PAYMENT_GATEWAY_URL="https://api.razorpay.com/v1/orders"
VITE_PAYMENT_API_KEY="rzp_live_your_api_key_here"
VITE_PAYMENT_WEBHOOK_URL="https://your-vercel-domain.vercel.app/api/webhook"
